<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mallchat.mapper.CategoryMapper">
  <resultMap id="CategoryItemMap" type="com.mallchat.vo.CategoryItem">
    <id property="id" column="id" />
    <result property="name" column="name" />
    <result property="parentId" column="parent_id" />
    <result property="level" column="level" />
    <result property="sort" column="sort" />
  </resultMap>

  <select id="findById" resultType="com.mallchat.model.Category">
    SELECT id, name, parent_id, level, sort, status, created_at, updated_at
    FROM category
    WHERE id = #{id}
  </select>

  <select id="listAll" resultMap="CategoryItemMap">
    SELECT id, name, parent_id, level, sort
    FROM category
    WHERE status = 1
    ORDER BY level ASC, sort DESC, id ASC
  </select>
</mapper>
