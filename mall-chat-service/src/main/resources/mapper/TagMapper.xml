<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mallchat.mapper.TagMapper">
  <select id="findByName" resultType="com.mallchat.model.Tag">
    SELECT id, name, status, created_at, updated_at
    FROM tag
    WHERE name = #{name}
    LIMIT 1
  </select>

  <insert id="insert" parameterType="com.mallchat.model.Tag" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO tag (name, status)
    VALUES (#{name}, #{status})
  </insert>
</mapper>
