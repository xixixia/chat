<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mallchat.mapper.SensitiveWhitelistMapper">
  <select id="listEnabled" resultType="com.mallchat.model.SensitiveWhitelist">
    SELECT id, word, enabled, created_at, updated_at
    FROM sensitive_whitelist
    WHERE enabled = 1
    ORDER BY id ASC
  </select>
</mapper>
